{
  "name": "@dsh-external/dsh-annotation-patched",
  "version": "0.3.8",
  "type": "module",
  "description": "Select text in a DSH Web assistant reply, add an optional note, and send the selection with your message. The model answers each annotation by number, and each numbered answer becomes a hoverable chip showing the quoted passage.",
  "icon": "./icon.svg",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.mjs && node --check client.js",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugins",
    "annotation",
    "quote",
    "selection",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDFXYqiming/dsh-annotation-patched.git"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7 || ^4.0.1"
  },
  "author": "DDDFXYqiming",
  "homepage": "https://github.com/DDDFXYqiming/dsh-annotation-patched#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}
